generator client {
  provider      = "prisma-client-js"
  output        = "../../src/generated/tenant"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  company_admin
  store_manager
  store_user
}

enum TransferStatus {
  pending
  completed
  cancelled
}

enum SaleStatus {
  completed
  partially_refunded
  refunded
}

// Money leaving or entering the business, recorded on a Payment row.
// payment = we pay out (e.g. settling what we owe a supplier).
// receive = we take in (e.g. collecting what a customer owes us).
enum TransactionType {
  payment
  receive
}

// Which side of the ledger the party sits on. Because customer_supplier_id is
// a loose int rather than a foreign key, this discriminator is the only thing
// that tells us which table the id points into - so it must always be set.
enum PartyType {
  customer
  supplier
}

// A money account the business holds: the till drawer, a bank account, an MFS
// wallet. This table is the single source of truth for the payment-method
// dropdowns - adding a row here is all it takes for the name to appear on the
// POS tender, the purchase method and the ledger's "paid by" list.
//
// It replaces what used to be two hard-coded enums (PaymentMethod for the POS
// tender and PaymentType for the ledger). An enum cannot express "this shop
// also takes Nagad via a partner merchant", which is exactly the kind of thing
// that varies per business, so the vocabulary lives in the database instead.
//
// `bankName` is stored verbatim on SalePayment.method, Purchase.paymentMethod
// and Payment.paymentType rather than as a foreign key to this row. Two
// reasons: `due` is a legitimate value on the first two and is NOT an account
// (no money ever moved), and a snapshot keeps history readable after a row is
// deactivated. Every write path re-checks the name against this table, so the
// loose string can never drift into a name that does not exist here.
//
// Balances:
//   initialBalance   - the opening figure the owner declares. Set once, at
//                      their convenience; never written by any other flow.
//   remainingBalance - the running figure. Every money movement that names
//                      this account adds to it (a sale, a receive) or subtracts
//                      from it (a purchase, a pay-out), inside the same
//                      transaction as the row that records the movement.
//
// Unlike Customer.dueAmount / Supplier.dueAmount this is deliberately NOT
// floored at zero: an overdrawn account is a real, reportable state.
model BankInfo {
  id               Int      @id @default(autoincrement())
  bankName         String   @unique
  initialBalance   Float    @default(0)
  remainingBalance Float    @default(0)
  // A deactivated account disappears from the dropdowns but keeps its history,
  // the same soft-delete convention Store/User/Category already use.
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  withdrawals      Withdrawal[]
  // No back-reference for expenditures: like SalePayment.method and
  // Purchase.paymentMethod, ExpenditureItem.paymentMethod is a snapshot string
  // rather than a foreign key, so there is no relation to point back from.
  // Both sides of a transfer are relations to this table, so the two have to be
  // told apart by name - an unnamed pair of relations between the same two
  // models is ambiguous and Prisma rejects it.
  transfersOut     BankTransfer[] @relation("BankTransferOut")
  transfersIn      BankTransfer[] @relation("BankTransferIn")

  // The one table in this schema that is not PascalCase, and deliberately so -
  // "bank_info" is the name the business calls it. Every other table has no
  // @@map and takes its physical name straight from the model.
  @@map("bank_info")
}

// The owner taking cash out of an account into their own pocket.
//
// A real FK to BankInfo, unlike SalePayment.method / Purchase.paymentMethod /
// Payment.paymentType - those three keep a *snapshot string* because they have
// to stay readable after an account is deactivated or deleted. A withdrawal is
// only ever about an account that exists right now, so it holds the id and the
// bank row cannot disappear underneath it. That is also why a withdrawal has no
// delete: voiding it restores the balance and keeps the row as the record of
// what was handed over.
//
// isActive follows the same convention as everywhere else in this schema:
// flipping it to false is the "remove" action, and it is what puts the amount
// back on the account (see src/lib/withdrawals.ts).
model Withdrawal {
  id             Int      @id @default(autoincrement())
  bankId         Int
  bank           BankInfo @relation(fields: [bankId], references: [id])
  withdrawalDate DateTime
  personName     String
  // Free text rather than typed: the same slip covers a bKash number, a bank
  // account number and "none given", and they are all under 40 characters.
  accountOrMobile String?
  amount          Float
  reason          String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([bankId])
  @@index([withdrawalDate])
}

// What the money was spent ON - "Salary", "Entertainment", "Rent".
//
// A plain vocabulary table, on the same footing as BankInfo.bankName: the owner
// types the heads their own business uses and they appear in the dropdown.
// Nothing here is hard-coded, because what counts as an expense is exactly the
// thing that varies per shop; the migration seeds a starter set so a brand new
// tenant is not staring at an empty box.
//
// `name` is unique so the same head cannot be added twice under two spellings
// that would then split a report in half. isActive is the "remove" action and
// follows the soft-delete convention Store/User/Withdrawal use: a head that has
// been spent against keeps its history, it just leaves the dropdown.
model ExpenditureHead {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  isActive  Boolean          @default(true)
  items     ExpenditureItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([isActive])
}

// One expense voucher: a header the owner dates and annotates, holding several
// ExpenditureItem lines that were settled together.
//
// The payment is made once, for the voucher, and never line by line: the lines
// answer "what was this spent on", and the total answers "and how was it paid".
// That is the whole reason there is no isPaid on ExpenditureItem.
//
// Company-wide, like Withdrawal and BankTransfer, because the thing it moves
// money through (an account in bank_info) is company-wide too. There is no
// storeId on purpose - see BankInfo for the same reasoning.
//
// The three optional extras are header-level rather than lines because they
// belong to the whole voucher, not to any one head: transport for the trip that
// covered all of it, a top-up that was not tied to a single item, and a discount
// the supplier gave back. All three default to 0 so a voucher with none of them
// is the ordinary case. `discount` reduces the voucher total, and therefore what
// comes out of the account - a discount the owner records but that does not
// change the money is not a discount, it is a note.
//
// totalAmount / paidAmount are stored rather than derived on read, because they
// are the figures the list sorts and sums by and a voucher is immutable history:
// recomputing them per row on every list request would mean summing every line
// of every voucher in the company each time. Both are written by the same code
// that moves the balances, in the same transaction, so they cannot drift from
// the money.
//
// isActive is the "delete": the money has already moved, so removing the voucher
// has to move it back (see src/lib/expenditures.ts). There is no hard delete on
// purpose, for the same reason Withdrawal has none.
model Expenditure {
  id           Int              @id @default(autoincrement())
  expenditureDate DateTime
  note         String?          @db.Text
  // The optional header-level extras. Zero means "not recorded", not "free".
  transportationCost Float        @default(0)
  additionalCost     Float        @default(0)
  discount           Float        @default(0)
  // lineSum + transportationCost + additionalCost - discount.
  totalAmount Float @default(0)
  // What actually left an account. Equal to totalAmount once the voucher is
  // settled, and 0 while it is still outstanding.
  paidAmount  Float            @default(0)
  // The payment is a property of the whole voucher, not of each line: the heads
  // say what the money was spent ON, and only once they have all been added up
  // is there a single answer to "and how was it paid". So one account for the
  // entire voucher, and one paid/unpaid switch covering all of it.
  //
  // paymentMethod is a BankInfo.bankName snapshot, not a foreign key, for the
  // same reason SalePayment.method is: an account can be deactivated or deleted
  // afterwards and the voucher still has to say which account it went through.
  // Every write path re-checks the name against bank_info, so the loose string
  // cannot drift into an account that does not exist.
  paymentMethod String?
  // Whether the voucher has been settled. Unpaid costs nothing - no balance
  // moves - which is what makes "recorded, not yet paid" a legitimate state.
  isPaid      Boolean          @default(true)
  isActive    Boolean          @default(true)
  items       ExpenditureItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([expenditureDate])
  @@index([createdAt])
  // One account per voucher, so paymentMethod is the only payment column left
  // worth an index on - it is what the balance filters and reports read.
  @@index([paymentMethod])
}

// One line of a voucher: this much money, spent on this head.
//
// A line carries no payment information at all. What the money was spent ON is
// the line's business; how the total was paid belongs to the voucher, because
// the owner settles one amount in one go rather than paying each head
// separately (see Expenditure.paymentMethod).
//
// A real FK to ExpenditureHead - a line can only ever be booked against a head
// that exists right now, so the head row cannot disappear underneath it. That
// is also why a head that has been spent against cannot be deleted, only
// deactivated.
model ExpenditureItem {
  id            Int            @id @default(autoincrement())
  expenditure   Expenditure    @relation(fields: [expenditureId], references: [id])
  expenditureId Int
  head          ExpenditureHead @relation(fields: [headId], references: [id])
  headId        Int
  // Optional free text for the line itself, on top of the head it is filed
  // under - "March overtime", "client dinner".
  description String?
  // Whether this line had a bill of its own, and which one. A number or memo
  // the owner can type, not an uploaded scan: the paperwork lives in a file
  // cabinet, the number is what has to be searchable later.
  billNo    String?
  amount    Float
  createdAt DateTime @default(now())

  @@index([expenditureId])
  @@index([headId])
}

// The owner moving money out of one of their accounts and into another - cash
// into the till to top it up, a balance shifted from bKash into a bank account
// to pay a supplier from.
//
// Two real foreign keys to BankInfo, and the same reasoning as Withdrawal applies
// to both of them: a transfer is only ever about accounts that exist right now,
// so it holds their ids and neither row can be deleted underneath it. It is
// also the one movement in the app that pushes TWO balances at once, in
// opposite directions, inside a single transaction - which is exactly what
// makes it impossible to half-apply.
//
// There is deliberately no date column: `createdAt` is when the transfer was
// recorded and is what the statement orders by. Unlike a purchase or a payment -
// which are often logged a day or two late, because the paperwork turns up after
// the fact - a transfer is something the owner does on the spot, so backdating
// it would only ever be an attempt to make the statement lie.
//
// isActive is the "delete": the amount has already moved between the two
// accounts, so removing the row has to move it back (see
// src/lib/bank-transfers.ts) or both accounts would be out by a sum nobody can
// trace. A voided transfer stays visible as the correction it was.
model BankTransfer {
  id Int @id @default(autoincrement())
  // Named relations, matching the two back-references on BankInfo.
  fromBank   BankInfo @relation("BankTransferOut", fields: [fromBankId], references: [id])
  fromBankId Int
  toBank     BankInfo @relation("BankTransferIn", fields: [toBankId], references: [id])
  toBankId   Int
  // Always the size of the movement. The direction lives in the two columns
  // above, so there is no sign to get wrong and no way to store a transfer that
  // would add to both accounts or subtract from both.
  amount  Float
  // Why the money moved, or which reference it went out under. Optional: most
  // transfers are obvious from the two account names.
  remarks   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromBankId])
  @@index([toBankId])
  @@index([createdAt])
}

// Singleton (id always 1), seeded at provisioning time.
// The DAL cross-checks this against the session's companyId as a
// defense-in-depth guard against a misrouted tenant database mapping.
model TenantConfig {
  id          Int    @id @default(1)
  companyId   Int    @unique
  companyName String
}

// Fixed catalog of granular capabilities (e.g. can_process_returns).
// Role defaults live in code (src/lib/permissions.ts); rows here only
// exist to validate permission keys and back per-user overrides.
model Permission {
  key         String                   @id
  label       String
  description String?
  overrides   UserPermissionOverride[]
}

model UserPermissionOverride {
  id            Int        @id @default(autoincrement())
  user          User       @relation(fields: [userId], references: [id])
  userId        Int
  permission    Permission @relation(fields: [permissionKey], references: [key])
  permissionKey String
  allow         Boolean
  createdAt     DateTime   @default(now())

  @@unique([userId, permissionKey])
}

model User {
  id                  Int                      @id @default(autoincrement())
  name                String
  email               String                   @unique
  password            String
  role                Role
  store               Store?                   @relation(fields: [storeId], references: [id])
  storeId             Int?
  isActive            Boolean                  @default(true)
  // UI language this account last chose ("en" or "bn"). Kept on the account
  // so a re-login restores it, and copied into the signed session token.
  language            String                   @default("en")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  permissionOverrides UserPermissionOverride[]
}

model Store {
  id         Int         @id @default(autoincrement())
  name       String
  address    String?
  phone      String?
  // Public path of the store's picture/logo, written to disk under
  // public/uploads/company-<companyId>/stores/ and served as a static file.
  // Null until an image is uploaded.
  imageUrl   String?
  isActive   Boolean     @default(true)
  warehouses Warehouse[]
  users      User[]
  createdAt  DateTime    @default(now())
}

model Warehouse {
  id              Int              @id @default(autoincrement())
  store           Store            @relation(fields: [storeId], references: [id])
  storeId         Int
  name            String
  location        String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  stock           WarehouseStock[]
  purchases       Purchase[]
  purchaseItems   PurchaseItem[]
  supplierReturns SupplierReturn[]
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  parentId  Int?
  children  Category[] @relation("CategoryToCategory")
  products  Product[]
  createdAt DateTime   @default(now())
}

model Product {
  id              Int              @id @default(autoincrement())
  sku             String           @unique
  name            String
  category        Category?        @relation(fields: [categoryId], references: [id])
  categoryId      Int?
  supplier        Supplier?        @relation(fields: [supplierId], references: [id])
  supplierId      Int?
  purchasePrice   Decimal          @db.Decimal(10, 2)
  salePrice       Decimal          @db.Decimal(10, 2)
  taxRate         Decimal          @default(0) @db.Decimal(5, 2)
  // Package/measurement size, e.g. unitValue=250, unit="ml" for a 250ml
  // Coca-Cola bottle - set at the company catalog level (see
  // /company/products); price stays editable per-store via
  // /store/warehouses/[id]/products.
  unitValue       Decimal?         @db.Decimal(10, 2)
  unit            String?
  isActive        Boolean          @default(true)
  stock           WarehouseStock[]
  purchaseItems   PurchaseItem[]
  supplierReturns SupplierReturn[]
  createdAt       DateTime         @default(now())
}

model WarehouseStock {
  id                Int       @id @default(autoincrement())
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId       Int
  product           Product   @relation(fields: [productId], references: [id])
  productId         Int
  quantity          Int       @default(0)
  lowStockThreshold Int       @default(5)
  updatedAt         DateTime  @updatedAt

  @@unique([warehouseId, productId])
}

model StockTransfer {
  id              Int                 @id @default(autoincrement())
  fromWarehouseId Int
  toWarehouseId   Int
  status          TransferStatus      @default(pending)
  requestedById   Int
  completedById   Int?
  items           StockTransferItem[]
  createdAt       DateTime            @default(now())
  completedAt     DateTime?
}

model StockTransferItem {
  id         Int           @id @default(autoincrement())
  transfer   StockTransfer @relation(fields: [transferId], references: [id])
  transferId Int
  productId  Int
  quantity   Int
}

model Supplier {
  id              Int              @id @default(autoincrement())
  name            String
  phone           String?
  email           String?
  address         String?
  isActive        Boolean          @default(true)
  // Money still owed TO this supplier. Running balance, adjusted when a
  // purchase is recorded and when a payment is made against it. 0 means
  // nothing outstanding (or never captured).
  dueAmount       Float            @default(0)
  products        Product[]
  purchases       Purchase[]
  supplierReturns SupplierReturn[]
  createdAt       DateTime         @default(now())
}

// A stock-in event: goods received from a supplier. Increments
// WarehouseStock on creation (see /api/store/purchases). One purchase can
// span several warehouses, so each PurchaseItem carries its own warehouseId;
// Purchase.warehouseId is only the primary one (the first line) and is null
// when the lines are spread across different warehouses.
model Purchase {
  id            Int            @id @default(autoincrement())
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  supplierId    Int
  warehouse     Warehouse?     @relation(fields: [warehouseId], references: [id])
  warehouseId   Int?
  receivedById  Int
  reference     String?
  totalCost     Decimal        @db.Decimal(12, 2)
  // The BankInfo.bankName this delivery was settled through, or "due" when
  // nothing was paid and the whole totalCost went onto Supplier.dueAmount.
  // Nullable because rows written before this column existed have no recorded
  // method; it is a loose String rather than a foreign key for the reason
  // given on BankInfo.
  paymentMethod String?
  items         PurchaseItem[]
  // When the goods were actually received (editable - can backdate to
  // "bought yesterday"), separate from createdAt which is the audit
  // record-insertion timestamp.
  purchasedAt   DateTime       @default(now())
  createdAt     DateTime       @default(now())
}

model PurchaseItem {
  id          Int       @id @default(autoincrement())
  purchase    Purchase  @relation(fields: [purchaseId], references: [id])
  purchaseId  Int
  product     Product   @relation(fields: [productId], references: [id])
  productId   Int
  // Where this line's goods were put away - one purchase can feed several
  // warehouses from the same supplier delivery.
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId Int
  quantity    Int
  unitCost    Decimal   @db.Decimal(10, 2)
}

// Stock sent back to a supplier (e.g. damaged/wrong goods). Decrements
// WarehouseStock on creation - not linked to a specific Purchase batch,
// since the same product may have been received from this supplier
// across several purchases.
model SupplierReturn {
  id            Int       @id @default(autoincrement())
  supplier      Supplier  @relation(fields: [supplierId], references: [id])
  supplierId    Int
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId   Int
  product       Product   @relation(fields: [productId], references: [id])
  productId     Int
  quantity      Int
  // Credit value expected back from the supplier. Defaults to the product's
  // purchasePrice x quantity at the time the return is recorded, but stays
  // editable because the supplier may only credit part of it. 0 means the
  // amount was never captured (rows predating this column).
  amount        Decimal   @default(0) @db.Decimal(12, 2)
  reason        String?
  processedById Int
  createdAt     DateTime  @default(now())
}

model Customer {
  id            Int      @id @default(autoincrement())
  name          String
  phone         String?
  email         String?
  loyaltyPoints Int      @default(0)
  // Money this customer still owes the shop. Running balance, adjusted when
  // a sale is booked on credit and when they pay it off. 0 means nothing
  // outstanding (or never captured).
  dueAmount     Float    @default(0)
  sales         Sale[]
  createdAt     DateTime @default(now())
}

model Sale {
  id             Int           @id @default(autoincrement())
  storeId        Int
  warehouseId    Int
  cashierId      Int
  customer       Customer?     @relation(fields: [customerId], references: [id])
  customerId     Int?
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  status         SaleStatus    @default(completed)
  items          SaleItem[]
  payments       SalePayment[]
  returns        Return[]
  createdAt      DateTime      @default(now())
}

model SaleItem {
  id             Int     @id @default(autoincrement())
  sale           Sale    @relation(fields: [saleId], references: [id])
  saleId         Int
  productId      Int
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(12, 2)
}

model SalePayment {
  id        Int      @id @default(autoincrement())
  sale      Sale     @relation(fields: [saleId], references: [id])
  saleId    Int
  // BankInfo.bankName for a real tender. A `due` sale writes no SalePayment
  // row at all - a payment row reads as "money received", and none was - so
  // this column only ever holds a real account name.
  method    String
  amount    Decimal  @db.Decimal(12, 2)
  reference String?
}

// A money movement recorded against a customer or a supplier - the ledger
// behind Customer.dueAmount / Supplier.dueAmount. "receive" takes in what a
// customer owes, "payment" pays out what we owe a supplier.
//
// Deliberately not a relation: one table covers both sides, so the id is a
// loose int qualified by `type` instead of a real foreign key. That buys a
// single table and a single form for both flows at the cost of referential
// integrity - a deleted Customer/Supplier leaves these rows orphaned, and
// nothing at the database level stops a wrong `type`/id pairing. Every
// write path must verify the id against the table `type` names.
model Payment {
  id                 Int             @id @default(autoincrement())
  // Human-facing trace/reference number for the movement (receipt no, bank
  // ref). Unique so the same external transaction can never be booked twice -
  // this is the guard against a double-submitted form posting the money again.
  transactionId      String          @unique
  transactionType    TransactionType
  // BankInfo.bankName - the account the money moved through, so the ledger can
  // be reconciled against that account's remainingBalance. Deliberately
  // separate from the POS tender (SalePayment.method): no card terminal is in
  // play for settling a due, but a bank transfer very much is.
  paymentType        String
  type               PartyType
  // Points at Customer.id when type = customer, Supplier.id when
  // type = supplier. NOT a foreign key (see above).
  customerSupplierId Int
  // When the money actually moved, editable so a payment can be backdated to
  // "paid last Tuesday" - separate from createdAt, which is the audit record
  // insertion timestamp.
  paymentDate        DateTime        @default(now())
  paymentAmount      Float
  description        String?         @db.Text
  // Soft delete: a booked payment stays for the audit trail, and `isActive`
  // lets a mistaken entry be voided without losing the row. Amounts already
  // rolled into a dueAmount balance are not recalculated here.
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())

  @@index([type, customerSupplierId])
  @@index([paymentDate])
}

model Return {
  id            Int          @id @default(autoincrement())
  sale          Sale         @relation(fields: [saleId], references: [id])
  saleId        Int
  storeId       Int
  warehouseId   Int
  processedById Int
  reason        String?
  refundAmount  Decimal      @db.Decimal(12, 2)
  items         ReturnItem[]
  createdAt     DateTime     @default(now())
}

model ReturnItem {
  id         Int     @id @default(autoincrement())
  return     Return  @relation(fields: [returnId], references: [id])
  returnId   Int
  saleItemId Int
  quantity   Int
  restocked  Boolean @default(false)
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  userEmail  String?
  action     String
  entityType String
  entityId   Int?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
}
