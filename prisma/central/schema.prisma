generator client {
  provider      = "prisma-client-js"
  output        = "../../src/generated/central"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("CENTRAL_DATABASE_URL")
}

enum CompanyStatus {
  provisioning
  active
  suspended
  failed
  archived
}

enum TenantDbStatus {
  pending
  creating_db
  migrating
  seeding
  ready
  failed
}

enum SubscriptionStatus {
  pending
  active
  expired
  cancelled
}

enum PaymentMethodType {
  bkash
  nagad
  rocket
}

enum PlanDuration {
  monthly
  quarterly
  yearly
  custom
}

enum PaymentReviewStatus {
  pending
  approved
  rejected
}

model ProjectAdmin {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Company {
  id                   Int                     @id @default(autoincrement())
  name                 String
  slug                 String                  @unique
  status               CompanyStatus           @default(provisioning)
  tenantDb             TenantDatabase?
  subscription         Subscription?
  subscriptionPayments SubscriptionPayment[]
  notifications        Notification[]
  metricsSnapshot      CompanyMetricsSnapshot?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
}

model TenantDatabase {
  id        Int            @id @default(autoincrement())
  company   Company        @relation(fields: [companyId], references: [id])
  companyId Int            @unique
  dbName    String         @unique
  dbHost    String?
  dbPort    Int?
  status    TenantDbStatus @default(pending)
  lastError String?        @db.Text
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model SubscriptionPlan {
  id            Int                   @id @default(autoincrement())
  name          String                @unique
  duration      PlanDuration
  durationDays  Int
  price         Decimal               @db.Decimal(10, 2)
  isActive      Boolean               @default(true)
  subscriptions Subscription[]
  payments      SubscriptionPayment[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model PaymentMethodConfig {
  id           Int               @id @default(autoincrement())
  method       PaymentMethodType @unique
  displayName  String
  instructions String?           @db.Text
  isEnabled    Boolean           @default(true)
}

// Current subscription cycle for a company - one row per company.
// Denormalizes the latest payment's method/transactionId/amount for
// cheap dashboard reads; SubscriptionPayment is the full history.
model Subscription {
  id            Int                   @id @default(autoincrement())
  company       Company               @relation(fields: [companyId], references: [id])
  companyId     Int                   @unique
  plan          SubscriptionPlan?     @relation(fields: [planId], references: [id])
  planId        Int?
  status        SubscriptionStatus    @default(pending)
  paymentMethod PaymentMethodType?
  transactionId String?
  amount        Decimal?              @db.Decimal(10, 2)
  startDate     DateTime?
  endDate       DateTime?
  payments      SubscriptionPayment[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status])
  @@index([endDate])
}

// One row per payment submission/attempt - append-only audit trail,
// independent of Subscription's in-place fields above.
model SubscriptionPayment {
  id             Int                 @id @default(autoincrement())
  subscription   Subscription        @relation(fields: [subscriptionId], references: [id])
  subscriptionId Int
  company        Company             @relation(fields: [companyId], references: [id])
  companyId      Int
  plan           SubscriptionPlan?   @relation(fields: [planId], references: [id])
  planId         Int?
  paymentMethod  PaymentMethodType
  transactionId  String              @unique
  amount         Decimal             @db.Decimal(10, 2)
  screenshotPath String?
  status         PaymentReviewStatus @default(pending)
  reviewedById   Int?
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime            @default(now())

  @@index([companyId])
  @@index([status])
}

model AdvertisementSettings {
  id               Int      @id @default(1)
  adsenseClientId  String?
  adUnitId         String?
  placement        String   @default("modal")
  countdownSeconds Int      @default(15)
  isEnabled        Boolean  @default(true)
  frequencyMinutes Int      @default(30)
  updatedAt        DateTime @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId Int
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([companyId, isRead])
}

// Periodic rollup of each tenant's headline metrics, refreshed by
// POST /api/admin/reports/refresh (a stand-in for a scheduled job in
// this MVP). The Project Admin dashboard reads only from this table -
// it never fans out live to every tenant database on each page load.
model CompanyMetricsSnapshot {
  id           Int      @id @default(autoincrement())
  company      Company  @relation(fields: [companyId], references: [id])
  companyId    Int      @unique
  totalSales   Decimal  @db.Decimal(14, 2)
  totalRefunds Decimal  @db.Decimal(14, 2)
  salesCount   Int
  storeCount   Int
  userCount    Int
  refreshedAt  DateTime @default(now())
}

model CentralAuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  action     String
  targetType String
  targetId   Int?
  metadata   Json?
  createdAt  DateTime @default(now())
}
