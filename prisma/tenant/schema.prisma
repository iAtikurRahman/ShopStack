generator client {
  provider      = "prisma-client-js"
  output        = "../../src/generated/tenant"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  company_admin
  store_manager
  store_user
}

enum TransferStatus {
  pending
  completed
  cancelled
}

enum SaleStatus {
  completed
  partially_refunded
  refunded
}

// How the customer handed the money over at the till.
//
// bkash/rocket/nagad/upay/banglaqr are the Bangladeshi mobile financial
// services, named individually rather than lumped under one "mobile" value:
// each carries its own reporting and reconciliation, and a shop that takes 200
// bKash a day has no use for a figure that mixes it with Nagad.
enum PaymentMethod {
  cash
  card
  bkash
  rocket
  nagad
  upay
  banglaqr
  other
  // Nothing was handed over at the till. The whole amount is added to the
  // party's dueAmount instead, so no SalePayment / purchase method row is
  // written for it - a Payment row would read as "money received", which is
  // exactly what did not happen. Settling it later is a separate movement.
  due
}

// Money leaving or entering the business, recorded on a Payment row.
// payment = we pay out (e.g. settling what we owe a supplier).
// receive = we take in (e.g. collecting what a customer owes us).
enum TransactionType {
  payment
  receive
}

// How the money actually moved. Deliberately separate from PaymentMethod
// (the POS tender types): no card terminal is in play for settling a due,
// but a bank transfer or an MFS wallet transfer very much is.
enum PaymentType {
  bank
  cash
  bkash
  rocket
  nagad
  upay
  banglaqr
  other
}

// Which side of the ledger the party sits on. Because customer_supplier_id is
// a loose int rather than a foreign key, this discriminator is the only thing
// that tells us which table the id points into - so it must always be set.
enum PartyType {
  customer
  supplier
}

// Singleton (id always 1), seeded at provisioning time.
// The DAL cross-checks this against the session's companyId as a
// defense-in-depth guard against a misrouted tenant database mapping.
model TenantConfig {
  id          Int    @id @default(1)
  companyId   Int    @unique
  companyName String
}

// Fixed catalog of granular capabilities (e.g. can_process_returns).
// Role defaults live in code (src/lib/permissions.ts); rows here only
// exist to validate permission keys and back per-user overrides.
model Permission {
  key         String                   @id
  label       String
  description String?
  overrides   UserPermissionOverride[]
}

model UserPermissionOverride {
  id            Int        @id @default(autoincrement())
  user          User       @relation(fields: [userId], references: [id])
  userId        Int
  permission    Permission @relation(fields: [permissionKey], references: [key])
  permissionKey String
  allow         Boolean
  createdAt     DateTime   @default(now())

  @@unique([userId, permissionKey])
}

model User {
  id                  Int                      @id @default(autoincrement())
  name                String
  email               String                   @unique
  password            String
  role                Role
  store               Store?                   @relation(fields: [storeId], references: [id])
  storeId             Int?
  isActive            Boolean                  @default(true)
  // UI language this account last chose ("en" or "bn"). Kept on the account
  // so a re-login restores it, and copied into the signed session token.
  language            String                   @default("en")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  permissionOverrides UserPermissionOverride[]
}

model Store {
  id         Int         @id @default(autoincrement())
  name       String
  address    String?
  phone      String?
  isActive   Boolean     @default(true)
  warehouses Warehouse[]
  users      User[]
  createdAt  DateTime    @default(now())
}

model Warehouse {
  id              Int              @id @default(autoincrement())
  store           Store            @relation(fields: [storeId], references: [id])
  storeId         Int
  name            String
  location        String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  stock           WarehouseStock[]
  purchases       Purchase[]
  purchaseItems   PurchaseItem[]
  supplierReturns SupplierReturn[]
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  parentId  Int?
  children  Category[] @relation("CategoryToCategory")
  products  Product[]
  createdAt DateTime   @default(now())
}

model Product {
  id              Int              @id @default(autoincrement())
  sku             String           @unique
  name            String
  category        Category?        @relation(fields: [categoryId], references: [id])
  categoryId      Int?
  supplier        Supplier?        @relation(fields: [supplierId], references: [id])
  supplierId      Int?
  purchasePrice   Decimal          @db.Decimal(10, 2)
  salePrice       Decimal          @db.Decimal(10, 2)
  taxRate         Decimal          @default(0) @db.Decimal(5, 2)
  // Package/measurement size, e.g. unitValue=250, unit="ml" for a 250ml
  // Coca-Cola bottle - set at the company catalog level (see
  // /company/products); price stays editable per-store via
  // /store/warehouses/[id]/products.
  unitValue       Decimal?         @db.Decimal(10, 2)
  unit            String?
  isActive        Boolean          @default(true)
  stock           WarehouseStock[]
  purchaseItems   PurchaseItem[]
  supplierReturns SupplierReturn[]
  createdAt       DateTime         @default(now())
}

model WarehouseStock {
  id                Int       @id @default(autoincrement())
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId       Int
  product           Product   @relation(fields: [productId], references: [id])
  productId         Int
  quantity          Int       @default(0)
  lowStockThreshold Int       @default(5)
  updatedAt         DateTime  @updatedAt

  @@unique([warehouseId, productId])
}

model StockTransfer {
  id              Int                 @id @default(autoincrement())
  fromWarehouseId Int
  toWarehouseId   Int
  status          TransferStatus      @default(pending)
  requestedById   Int
  completedById   Int?
  items           StockTransferItem[]
  createdAt       DateTime            @default(now())
  completedAt     DateTime?
}

model StockTransferItem {
  id         Int           @id @default(autoincrement())
  transfer   StockTransfer @relation(fields: [transferId], references: [id])
  transferId Int
  productId  Int
  quantity   Int
}

model Supplier {
  id              Int              @id @default(autoincrement())
  name            String
  phone           String?
  email           String?
  address         String?
  isActive        Boolean          @default(true)
  // Money still owed TO this supplier. Running balance, adjusted when a
  // purchase is recorded and when a payment is made against it. 0 means
  // nothing outstanding (or never captured).
  dueAmount       Float            @default(0)
  products        Product[]
  purchases       Purchase[]
  supplierReturns SupplierReturn[]
  createdAt       DateTime         @default(now())
}

// A stock-in event: goods received from a supplier. Increments
// WarehouseStock on creation (see /api/store/purchases). One purchase can
// span several warehouses, so each PurchaseItem carries its own warehouseId;
// Purchase.warehouseId is only the primary one (the first line) and is null
// when the lines are spread across different warehouses.
model Purchase {
  id            Int            @id @default(autoincrement())
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  supplierId    Int
  warehouse     Warehouse?     @relation(fields: [warehouseId], references: [id])
  warehouseId   Int?
  receivedById  Int
  reference     String?
  totalCost     Decimal        @db.Decimal(12, 2)
  // How the delivery was settled at the time it was booked. Nullable because
  // rows written before this column existed have no recorded method. `due`
  // means nothing was paid and the whole totalCost was added to
  // Supplier.dueAmount instead.
  paymentMethod PaymentMethod?
  items         PurchaseItem[]
  // When the goods were actually received (editable - can backdate to
  // "bought yesterday"), separate from createdAt which is the audit
  // record-insertion timestamp.
  purchasedAt   DateTime       @default(now())
  createdAt     DateTime       @default(now())
}

model PurchaseItem {
  id          Int       @id @default(autoincrement())
  purchase    Purchase  @relation(fields: [purchaseId], references: [id])
  purchaseId  Int
  product     Product   @relation(fields: [productId], references: [id])
  productId   Int
  // Where this line's goods were put away - one purchase can feed several
  // warehouses from the same supplier delivery.
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId Int
  quantity    Int
  unitCost    Decimal   @db.Decimal(10, 2)
}

// Stock sent back to a supplier (e.g. damaged/wrong goods). Decrements
// WarehouseStock on creation - not linked to a specific Purchase batch,
// since the same product may have been received from this supplier
// across several purchases.
model SupplierReturn {
  id            Int       @id @default(autoincrement())
  supplier      Supplier  @relation(fields: [supplierId], references: [id])
  supplierId    Int
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId   Int
  product       Product   @relation(fields: [productId], references: [id])
  productId     Int
  quantity      Int
  // Credit value expected back from the supplier. Defaults to the product's
  // purchasePrice x quantity at the time the return is recorded, but stays
  // editable because the supplier may only credit part of it. 0 means the
  // amount was never captured (rows predating this column).
  amount        Decimal   @default(0) @db.Decimal(12, 2)
  reason        String?
  processedById Int
  createdAt     DateTime  @default(now())
}

model Customer {
  id            Int      @id @default(autoincrement())
  name          String
  phone         String?
  email         String?
  loyaltyPoints Int      @default(0)
  // Money this customer still owes the shop. Running balance, adjusted when
  // a sale is booked on credit and when they pay it off. 0 means nothing
  // outstanding (or never captured).
  dueAmount     Float    @default(0)
  sales         Sale[]
  createdAt     DateTime @default(now())
}

model Sale {
  id             Int           @id @default(autoincrement())
  storeId        Int
  warehouseId    Int
  cashierId      Int
  customer       Customer?     @relation(fields: [customerId], references: [id])
  customerId     Int?
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  status         SaleStatus    @default(completed)
  items          SaleItem[]
  payments       SalePayment[]
  returns        Return[]
  createdAt      DateTime      @default(now())
}

model SaleItem {
  id             Int     @id @default(autoincrement())
  sale           Sale    @relation(fields: [saleId], references: [id])
  saleId         Int
  productId      Int
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(12, 2)
}

model SalePayment {
  id        Int           @id @default(autoincrement())
  sale      Sale          @relation(fields: [saleId], references: [id])
  saleId    Int
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
}

// A money movement recorded against a customer or a supplier - the ledger
// behind Customer.dueAmount / Supplier.dueAmount. "receive" takes in what a
// customer owes, "payment" pays out what we owe a supplier.
//
// Deliberately not a relation: one table covers both sides, so the id is a
// loose int qualified by `type` instead of a real foreign key. That buys a
// single table and a single form for both flows at the cost of referential
// integrity - a deleted Customer/Supplier leaves these rows orphaned, and
// nothing at the database level stops a wrong `type`/id pairing. Every
// write path must verify the id against the table `type` names.
model Payment {
  id                 Int             @id @default(autoincrement())
  // Human-facing trace/reference number for the movement (receipt no, bank
  // ref). Unique so the same external transaction can never be booked twice -
  // this is the guard against a double-submitted form posting the money again.
  transactionId      String          @unique
  transactionType    TransactionType
  paymentType        PaymentType
  type               PartyType
  // Points at Customer.id when type = customer, Supplier.id when
  // type = supplier. NOT a foreign key (see above).
  customerSupplierId Int
  // When the money actually moved, editable so a payment can be backdated to
  // "paid last Tuesday" - separate from createdAt, which is the audit record
  // insertion timestamp.
  paymentDate        DateTime        @default(now())
  paymentAmount      Float
  description        String?         @db.Text
  // Soft delete: a booked payment stays for the audit trail, and `isActive`
  // lets a mistaken entry be voided without losing the row. Amounts already
  // rolled into a dueAmount balance are not recalculated here.
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())

  @@index([type, customerSupplierId])
  @@index([paymentDate])
}

model Return {
  id            Int          @id @default(autoincrement())
  sale          Sale         @relation(fields: [saleId], references: [id])
  saleId        Int
  storeId       Int
  warehouseId   Int
  processedById Int
  reason        String?
  refundAmount  Decimal      @db.Decimal(12, 2)
  items         ReturnItem[]
  createdAt     DateTime     @default(now())
}

model ReturnItem {
  id         Int     @id @default(autoincrement())
  return     Return  @relation(fields: [returnId], references: [id])
  returnId   Int
  saleItemId Int
  quantity   Int
  restocked  Boolean @default(false)
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  userEmail  String?
  action     String
  entityType String
  entityId   Int?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
}
